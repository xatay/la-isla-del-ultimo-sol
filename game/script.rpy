screen juegopesca():
    if not tengopez1:
        imagebutton:
            idle "animations/pescar/pez_1.png"
            xpos 180 ypos 405
            action Function(pescar, 1)
    if not tengopez2:
        imagebutton:
            idle "animations/pescar/pez_2.png"
            xpos 1200 ypos 485
            action Function(pescar, 2)
    if not tengopez3:
        imagebutton:
            idle "animations/pescar/pez arcoiris.png"
            xpos 630 ypos 745
            action Function(pescar, 3)

label start:
    $ items = [] 
    $ evento1 = False
    $ evento2 = False
    $ evento3 = False
    $ evento4 = False
    $ felipeOrden = True
    $ pedirElBalde = False
    $ tobyNombre = False
    $ tobyMuerto = False
    $ preguntasluna = 0
    $ lunaNombre = False
    $ yaPesque = False
    $ estoyEnLaPlaya = False
    $ tengopez1 = False
    $ tengopez2 = False
    $ tengopez3 = False

    scene black
    window hide
    show text "{font=Inclitodo.ttf}{size=50}{color=#ffffff}Hace tres meses que llegué a esta isla...{/color}{/size}{/font}" at truecenter with fade
    $ renpy.pause() 

    # Fade out text
    hide text with fade

    show animation_sol zorder 5
    with dissolve
    show animation_luna at move_across zorder 10
    with dissolve

    show text "{font=Inclitodo.ttf}{size=100}{color=#ffffff}{vspace=750}La Isla del Último Sol{/color}{/size}{/font}"
    $ renpy.pause() 

    hide animation_sol with dissolve
    hide animation_luna with dissolve
    hide text with dissolve

    $renpy.movie_cutscene("video/1.webm")
    jump home1

label mesa1:
    scene mesa1
    $ renpy.pause()
    jump home1

label home1:
    call screen home1

label campa1:
    if felipeOrden:
        scene bgcampa1
        show teniente felipe with dissolve
        tf "¿Estaba durmiendo, soldado?"
        n "No, señor, estaba ordenando mis cosas."
        tf "El General quiere verte en su carpa."
        $ felipeOrden = False
        jump iroexplorar
    call screen campa1

menu iroexplorar:
    "Si, señor.":
        n "Si, señor."
        hide teniente felipe with dissolve
        stop bgs fadeout 1.0
        jump andaapescarpibe

    "Debo atender otros asuntos, señor.":
        n "Debo atender otros asuntos, señor."
        hide teniente felipe
        show teniente felipe molesto
        tf "Que no le tomen mucho tiempo soldado, sabe que al General no le gusta esperar."
        hide teniente felipe molesto with dissolve
        jump campa1

label campb1:
    call screen campb1

label campc1:
    call screen campc1

label andaapescarpibe:
    play bgs "bgs/Carpa Gral.opus"
    scene bgcarpageneral
    if evento3:
        show el general confundido with dissolve
        eg "Soldado?"
        n "Señor, debo informarle que cuando estuve en la playa ví una carpa y entré a investigar."
        hide el general confundido
        show el general
        eg "Y que encontró?"
        n "Adentro había una coneja blanca pero era distinta a nosotros."
        hide el general
        show el general disociado
        nd "Ella no usaba ropa y se paraba en cuatro patas."
        eg "No puede ser..."
        hide el general disociado
        show el general enojado
        eg "Lléveme a esta carpa de la que habla!"
        hide el general enojado with dissolve
        show black with dissolve
        stop bgs fadeout 1.0
        jump peleaconelgral
    else: 
        show el general with dissolve
        n "General, me dijeron que quería verme."
        eg "Soldado, le voy a dar una tarea muy importante. Acérquese, por favor."
        hide el general
        show el general pensando
        eg "Seguro habrá escuchado en el campamento que los suministros de alimento que trajimos resultaron pocos para la duración de esta misión."
        eg "Estamos esperando la llegada de un paquete muy importante, pero mientras tanto, todos debemos colaborar."
        np "¿Señor?"
        hide el general pensando
        show el general enojado
        eg "Le toca pescar, soldado."
        n "Si, señor."
        $ evento1 = True
        hide el general enojado with dissolve
        stop bgs fadeout 1.0
        jump campc1

label tinapancho1:
